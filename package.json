{
    "name": "terrafirmcraft-anvil-calculator",
    "version": "0.0.1",
    "description": "A web application for solving TerraFirmaCraft anvil recipes.",
    "license": "SEE LICENSE IN LICENSE.md",
    "private": true,
    "author": {
        "name": "G'lek Tarssza",
        "email": "glek@glektarssza.com",
        "url": "https://glektarssza.com"
    },
    "homepage": "https://glektarssza.com/minecraft-tools/terrafirmcraft/anvil-calculator/",
    "bugs": {
        "url": "https://github.com/glektarssza/minecraft-terrafirmacraft-anvil-calculator/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/glektarssza/minecraft-terrafirmacraft-anvil-calculator"
    },
    "packageManager": "pnpm@12.11.2",
    "type": "module",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "vite serve --mode development",
        "test": "vitest --run --coverage",
        "test:ci": "vitest --run --coverage",
        "test:ui": "vitest --ui",
        "lint": "pnpm run eslint && pnpm run cspell",
        "lint:fix": "pnpm run eslint:fix",
        "lint:ci": "pnpm run eslint:ci && pnpm run cspell:ci",
        "cspell": "cspell lint --cache .",
        "cspell:ci": "cspell lint --no-cache .",
        "eslint": "eslint --no-error-on-unmatched-pattern --cache ./src/ ./tests/",
        "eslint:fix": "eslint --no-error-on-unmatched-pattern --cache --fix ./src/ ./tests/",
        "eslint:ci": "eslint --no-error-on-unmatched-pattern ./src/ ./tests/",
        "prettier": "prettier --config ../.prettierrc.mjs --ignore-path ../.prettierignore --ignore-path ../.gitignore --cache --check .",
        "prettier:fix": "prettier --config ../.prettierrc.mjs --ignore-path ../.prettierignore --ignore-path ../.gitignore --cache --write .",
        "prettier:ci": "prettier --config ../.prettierrc.mjs --ignore-path ../.prettierignore --ignore-path ../.gitignore --check .",
        "build": "pnpm run build:prod",
        "build:all": "pnpm run build:production && pnpm run build:development",
        "build:prod": "pnpm run build:production",
        "build:production": "vite build --mode production",
        "build:dev": "pnpm run build:development",
        "build:development": "vite build --mode development",
        "clean": "pnpm run clean:prod",
        "clean:all": "pnpm run clean:production && pnpm run clean:development",
        "clean:prod": "pnpm run clean:production",
        "clean:production": "del-cli \"./dist/\"",
        "clean:dev": "pnpm run clean:development",
        "clean:development": "del-cli \"./dist/\"",
        "rebuild": "pnpm run rebuild:prod",
        "rebuild:all": "pnpm run clean:all && pnpm run build:all",
        "rebuild:prod": "pnpm run clean:prod && pnpm run build:prod",
        "rebuild:dev": "pnpm run clean:dev && pnpm run build:dev"
    },
    "dependencies": {},
    "devDependencies": {
        "@cspell/cspell-bundled-dicts": "^10.0.1",
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-replace": "^6.0.3",
        "@types/node": "^26.1.1",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-istanbul": "^4.1.10",
        "@vitest/eslint-plugin": "^1.6.27",
        "cspell": "^10.0.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-playwright": "^2.10.5",
        "globals": "^17.7.0",
        "jiti": "^2.7.0",
        "playwright": "^1.62.0",
        "prettier": "^3.9.6",
        "sass-embedded": "^1.100.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    }
}
