{
    "name": "Dev Container",
    "image": "debian:latest",
    "features": {
        "ghcr.io/devcontainers-extra/features/zsh-plugins": {
            "omzPlugins": "debian emoji screen tmux colorize gpg-agent gh node npm direnv colored-man-pages copyfile copypath copybuffer fnm"
        },
        "ghcr.io/devcontainers-extra/features/homebrew-package:neovim": {
            "package": "neovim",
            "version": "latest"
        },
        "ghcr.io/devcontainers-extra/features/homebrew-package:fnm": {
            "package": "fnm",
            "version": "latest"
        },
        "ghcr.io/devcontainers-extra/features/homebrew-package:direnv": {
            "package": "direnv",
            "version": "latest"
        },
        "ghcr.io/devcontainers-extra/features/homebrew-package:tmux": {
            "package": "tmux",
            "version": "latest"
        }
    },
    "overrideFeatureInstallOrder": [
        "ghcr.io/devcontainers-extra/features/homebrew-package:direnv",
        "ghcr.io/devcontainers-extra/features/homebrew-package:fnm",
        "ghcr.io/devcontainers-extra/features/homebrew-package:tmux",
        "ghcr.io/devcontainers-extra/features/zsh-plugins"
    ],
    "customizations": {
        "codespaces": {
            "openFiles": ["README.md"]
        },
        "vscode": {
            "extensions": [
                "EditorConfig.EditorConfig",
                "streetsidesoftware.code-spell-checker",
                "streetsidesoftware.code-spell-checker-cspell-bundled-dictionaries",
                "streetsidesoftware.code-spell-checker-canadian-english",
                "streetsidesoftware.code-spell-checker-win32",
                "mads-hartmann.bash-ide-vscode",
                "github.remotehub",
                "github.vscode-pull-request-github",
                "github.vscode-github-actions"
            ]
        }
    }
}
